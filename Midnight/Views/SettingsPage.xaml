<Page x:Class="Midnight.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding NavigateBackCommand}" Appearance="Secondary" Margin="0,0,15,0"/>
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1">

                <!-- Roblox Paths -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Roblox" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14"/>

                        <TextBlock Text="Custom Roblox Versions Path" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Path to a Bloxstrap or Fishstrap versions folder." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding CustomRobloxPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. C:\Users\...\AppData\Local\Bloxstrap\Versions"/>
                            <ui:Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCustomPathCommand}" Icon="{ui:SymbolIcon Folder24}" Appearance="Secondary" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Download Location" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding DownloadPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Select download folder..."/>
                            <ui:Button Grid.Column="1" Content="Browse" Command="{Binding BrowseDownloadPathCommand}" Icon="{ui:SymbolIcon Folder24}" Appearance="Secondary" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Custom Roblox Icon -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Custom Roblox Icon" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12">
                            Replace the icon inside RobloxPlayerBeta.exe at launch time (like Bloxstrap). Requires a .ico file. A backup of the original exe is created automatically.
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding CustomRobloxIconPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Select a .ico file (leave empty to use default Roblox icon)..."/>
                            <ui:Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCustomIconPathCommand}" Icon="{ui:SymbolIcon Image24}" Appearance="Secondary" Margin="8,0,4,0"/>
                            <ui:Button Grid.Column="2" Content="Clear" Command="{Binding ClearCustomIconCommand}" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Secondary"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Executor -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Executor Integration" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14"/>

                        <TextBlock Text="Executor Path" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding ExecutorPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Select your executor executable..."/>
                            <ui:Button Grid.Column="1" Content="Browse" Command="{Binding BrowseExecutorPathCommand}" Icon="{ui:SymbolIcon Search24}" Appearance="Secondary" Margin="8,0,0,0"/>
                        </Grid>

                        <ui:ToggleSwitch IsChecked="{Binding AutoLaunchExecutor}" Content="Auto-Launch Executor with Roblox" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Auto-Rejoin -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Auto-Rejoin" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14"/>

                        <TextBlock Text="Rejoin Delay (seconds)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="5" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding AutoRejoinDelaySeconds}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AutoRejoinDelaySeconds}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" Width="30" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- System Tray -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="System Tray" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14"/>

                        <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6">
                            <ui:ToggleSwitch.Content>
                                <StackPanel>
                                    <TextBlock Text="Minimize to System Tray"/>
                                    <TextBlock Text="Closing the window keeps the app running in the tray. Right-click the tray icon to switch accounts or exit." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:ToggleSwitch.Content>
                        </ui:ToggleSwitch>
                    </StackPanel>
                </ui:Card>

                <!-- Fast Flags -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Flag24" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                <TextBlock Text="Fast Flags" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                Override Roblox's internal feature flags via ClientAppSettings.json — just like Bloxstrap.
                                Enable presets (FPS unlock, DPI fix, disable telemetry…) or add your own custom flags.
                                Flags are written automatically before each launch.
                            </TextBlock>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="Open Fast Flags Editor"
                                   Icon="{ui:SymbolIcon ArrowRight24}"
                                   Command="{Binding NavigateToFastFlagsCommand}"
                                   Appearance="Secondary"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Grid>
                </ui:Card>

                <!-- Discord Integration -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Discord Integration" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14"/>

                        <ui:ToggleSwitch IsChecked="{Binding DiscordRpcEnabled}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16">
                            <ui:ToggleSwitch.Content>
                                <StackPanel>
                                    <TextBlock Text="Discord Rich Presence"/>
                                    <TextBlock Text="Shows the game you're playing in Discord, including game art and elapsed time — just like Bloxstrap." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:ToggleSwitch.Content>
                        </ui:ToggleSwitch>

                        <TextBlock Text="Webhook URL" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://discord.com/api/webhooks/..." Margin="0,0,0,6"/>
                        <TextBlock Text="Sends a notification to a Discord channel when accounts launch or disconnect." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Interface & Audio -->
                <ui:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="Interface &amp; Audio" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14"/>

                        <ui:ToggleSwitch IsChecked="{Binding SoundEffectsEnabled}" Content="Click Sound Effects" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                        <ui:ToggleSwitch IsChecked="{Binding AnimationsEnabled}" Content="UI Animations" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

