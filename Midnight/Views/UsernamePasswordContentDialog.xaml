<ui:ContentDialog x:Class="Midnight.Views.UsernamePasswordContentDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="Username &amp; Password Login"
      Width="400"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="24">
        <StackPanel>
            <!-- Info banner -->
            <Border CornerRadius="6" Background="#1A0078D4" BorderBrush="#330078D4"
                    BorderThickness="1" Padding="12,10" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" Foreground="#0078D4" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock Text="Two-step verification is not supported. Use Browser Login for accounts with 2FA enabled."
                               FontSize="12" Foreground="#0078D4" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Username -->
            <TextBlock Text="Username" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,6"/>
            <ui:TextBox x:Name="TxtUsername"
                        PlaceholderText="Enter your Roblox username"
                        Margin="0,0,0,16"
                        KeyDown="TxtField_KeyDown"/>

            <!-- Password -->
            <TextBlock Text="Password" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,6"/>
            <ui:PasswordBox x:Name="TxtPassword"
                            PlaceholderText="Enter your password"
                            PasswordChanged="TxtPassword_Changed"
                            Margin="0,0,0,20"
                            KeyDown="TxtField_KeyDown"/>

            <!-- Error message -->
            <Border x:Name="ErrorBanner" CornerRadius="6" Background="#1AE81123"
                    BorderBrush="#33E81123" BorderThickness="1" Padding="12,10"
                    Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="#E81123" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="TxtErrorMessage" FontSize="12" Foreground="#E81123"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Loading indicator -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"/>
                <TextBlock Text="Signing in..." VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                           Appearance="Secondary" Width="90" Margin="0,0,10,0"/>
                <ui:Button x:Name="BtnLogin" Content="Sign In" Click="BtnLogin_Click"
                           Appearance="Primary" Width="100" Icon="{ui:SymbolIcon PersonPasskey24}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</ui:ContentDialog>

