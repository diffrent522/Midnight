<Window x:Class="Midnight.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Midnight" Height="480" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowOuter"
                             Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.55" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowOuter"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.92" To="1.08" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowOuter"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92" To="1.08" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FloatStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoImage"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-5" To="5" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard" x:Name="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="StatusFadeStoryboard">
            <DoubleAnimation Storyboard.TargetName="StatusText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" Opacity="0"
            CornerRadius="20"
            Background="#0F0F2E"
            BorderBrush="#2A2A6A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#6C63FF" BlurRadius="40" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Ellipse Width="500" Height="500"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-200,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#226C63FF" Offset="0"/>
                        <GradientStop Color="#000F0F2E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Canvas IsHitTestVisible="False">
                <Ellipse Canvas.Left="30"  Canvas.Top="30"  Width="3" Height="3" Fill="#446C63FF" Opacity="0.7"/>
                <Ellipse Canvas.Left="320" Canvas.Top="50"  Width="2" Height="2" Fill="#44A78BFA" Opacity="0.6"/>
                <Ellipse Canvas.Left="50"  Canvas.Top="380" Width="2" Height="2" Fill="#446C63FF" Opacity="0.5"/>
                <Ellipse Canvas.Left="330" Canvas.Top="400" Width="3" Height="3" Fill="#44A78BFA" Opacity="0.7"/>
                <Ellipse Canvas.Left="180" Canvas.Top="20"  Width="2" Height="2" Fill="#44E8E8FF" Opacity="0.4"/>
                <Ellipse Canvas.Left="200" Canvas.Top="450" Width="2" Height="2" Fill="#44E8E8FF" Opacity="0.4"/>
            </Canvas>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="300">

                <Grid Width="140" Height="140" Margin="0,0,0,28" HorizontalAlignment="Center">

                    <Ellipse x:Name="GlowOuter" Width="140" Height="140" Opacity="0.25">
                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                        <Ellipse.RenderTransform>
                            <ScaleTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF6C63FF" Offset="0.3"/>
                                <GradientStop Color="#006C63FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#336C63FF" Offset="0"/>
                                <GradientStop Color="#001A1A50" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse x:Name="LogoImage" Width="90" Height="90"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                        <Ellipse.RenderTransform>
                            <TranslateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/Midnight;component/Resources/app.ico"
                                        Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#6C63FF" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <TextBlock Text="Midnight"
                           FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#E8E8FF"
                           FontFamily="Segoe UI"
                           Margin="0,0,0,6">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#6C63FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="Best Roblox Utility App"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#9090C0"
                           FontFamily="Segoe UI"
                           Margin="0,0,0,40"/>

                <ui:ProgressRing x:Name="LoadingRing"
                                 IsIndeterminate="True"
                                 Width="36" Height="36"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,18"
                                 Foreground="#6C63FF"/>

                <TextBlock x:Name="StatusText"
                           Text="Initializing…"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#9090C0"
                           FontFamily="Segoe UI"
                           Opacity="1"
                           Margin="0,0,0,0"/>

                <TextBlock x:Name="VersionText"
                           Text="v2.0.0"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Foreground="#505080"
                           FontFamily="Segoe UI"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>