<Page x:Class="Midnight.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="960"
      Title="About">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,24,30,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,28">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding NavigateBackCommand}"
                           Appearance="Secondary" Margin="0,0,15,0"/>
                <TextBlock Text="About" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="16" Margin="0,0,0,32" Padding="0,40,0,36"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F0F2E" Offset="0"/>
                        <GradientStop Color="#1A1A50" Offset="0.5"/>
                        <GradientStop Color="#0F0F2E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Ellipse Width="320" Height="220"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-20,0,0" Opacity="0.18">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#6C63FF" Offset="0"/>
                                <GradientStop Color="#006C63FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel HorizontalAlignment="Center">

                        <Grid Width="160" Height="160"
                              HorizontalAlignment="Center" Margin="0,0,0,24">

                            <Ellipse Width="160" Height="160" Opacity="0.22">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#6C63FF" Offset="0.2"/>
                                        <GradientStop Color="#006C63FF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse Width="130" Height="130"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="#446C63FF" StrokeThickness="1.5"/>

                            <Ellipse Width="116" Height="116"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/Midnight;component/Resources/app.ico"
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#6C63FF"
                                                      BlurRadius="28"
                                                      ShadowDepth="0"
                                                      Opacity="0.75"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>

                        <TextBlock Text="{Binding AppName}"
                                   FontSize="38" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Foreground="#E8E8FF"
                                   Margin="0,0,0,6">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#6C63FF" BlurRadius="14"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Border HorizontalAlignment="Center"
                                CornerRadius="20" Padding="16,5"
                                Margin="0,0,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#226C63FF" Offset="0"/>
                                    <GradientStop Color="#22A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#556C63FF" Offset="0"/>
                                    <GradientStop Color="#55A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#A78BFA"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="The most powerful Roblox account manager."
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="#9090C0"
                                   FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#226C63FF" Offset="0"/>
                                        <GradientStop Color="#22A78BFA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16"
                                               Foreground="#A78BFA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UpdateStatus}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ui:ProgressRing Grid.Column="1"
                                             IsIndeterminate="True"
                                             Width="18" Height="18"
                                             Foreground="#6C63FF"
                                             Visibility="{Binding IsCheckingForUpdate,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <ui:Button Content="Check for Updates"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding CheckForUpdatesCommand}"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Primary"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2234D399" Offset="0"/>
                                        <GradientStop Color="#226C63FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ui:SymbolIcon Symbol="Code24" FontSize="16"
                                               Foreground="#34D399"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Developer" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Developer}"
                                   FontSize="22" FontWeight="Bold"
                                   Margin="0,0,0,4"
                                   Foreground="#E8E8FF"/>
                        <TextBlock Text="Project Lead &amp; Developer"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,20"/>

                        <ui:Button Content="GitHub"
                                   Icon="{ui:SymbolIcon Code24}"
                                   Command="{Binding OpenGitHubCommand}"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Secondary"
                                   Margin="0,0,0,8"/>

                        <ui:Button Content="Discord"
                                   Icon="{ui:SymbolIcon Chat24}"
                                   Command="{Binding OpenDiscord2Command}"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Secondary"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" CornerRadius="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22FBBF24" Offset="0"/>
                                        <GradientStop Color="#22F87171" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ui:SymbolIcon Symbol="Star24" FontSize="16"
                                               Foreground="#FBBF24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Credits" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Weao" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E8E8FF" Margin="0,0,0,2"/>
                        <TextBlock Text="Executor Information API"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,10"/>
                        <ui:Button Content="Discord"
                                   Icon="{ui:SymbolIcon Chat24}"
                                   Command="{Binding OpenDiscord2Command}"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Secondary"
                                   Margin="0,0,0,16"/>

                        <Rectangle Height="1"
                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Open Source Libraries"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="• WPF-UI  •  CommunityToolkit.Mvvm"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="• Microsoft WebView2  •  DiscordRPC"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,12"/>
                        <ui:Button Content="WPF-UI on GitHub"
                                   Icon="{ui:SymbolIcon Code24}"
                                   Command="{Binding OpenWpfUiCommand}"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Secondary"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="© 2026 Midnight. Built with ♥ using WPF &amp; .NET 8."
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Foreground="#505080"/>
        </Grid>
    </ScrollViewer>
</Page>