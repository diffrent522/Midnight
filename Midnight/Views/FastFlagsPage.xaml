<Page x:Class="Midnight.Views.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Midnight.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding NavigateBackCommand}"
                           Appearance="Secondary" Margin="0,0,15,0"/>
                <ui:SymbolIcon Symbol="Flag24" FontSize="22"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Fast Flags" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" x:Name="ContentPanel">

                <!-- Master toggle + Apply button -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:ToggleSwitch IsChecked="{Binding FastFlagsEnabled}"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ui:ToggleSwitch.Content>
                                <StackPanel>
                                    <TextBlock Text="Enable Fast Flag Management"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap">
                                        When enabled, flags are written to ClientAppSettings.json in every
                                        detected Roblox version folder before each launch — just like Bloxstrap.
                                        Disable to revert to Roblox defaults.
                                    </TextBlock>
                                </StackPanel>
                            </ui:ToggleSwitch.Content>
                        </ui:ToggleSwitch>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <ui:Button Content="Apply Now"
                                       Icon="{ui:SymbolIcon Checkmark24}"
                                       Command="{Binding ApplyNowCommand}"
                                       Appearance="Primary"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                       Margin="0,0,8,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Status bar -->
                <Border Margin="0,0,0,12" Padding="14,10"
                        CornerRadius="6"
                        Visibility="{Binding StatusMessage,
                            Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ── JSON Import / Export ─────────────────────────── -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="DocumentArrowDown24" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="Import / Export JSON" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock FontSize="12" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap">
                            Paste a ClientAppSettings.json object to bulk-import flags, or click Export to
                            serialise your current flags. Supports strings, booleans, numbers and null.
                        </TextBlock>

                        <!-- Textarea -->
                        <TextBox Text="{Binding JsonImportText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="180"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="10"
                                 Margin="0,0,0,10"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                 BorderThickness="1"/>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Export Current Flags"
                                       Icon="{ui:SymbolIcon ArrowExportUp24}"
                                       Command="{Binding ExportJsonCommand}"
                                       Appearance="Secondary"
                                       Margin="0,0,8,0"/>
                            <ui:Button Content="Import into Flags"
                                       Icon="{ui:SymbolIcon ArrowImport24}"
                                       Command="{Binding ImportJsonCommand}"
                                       Appearance="Primary"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- ── Presets ──────────────────────────────────────── -->
                <ui:Card Margin="0,0,0,12" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Presets" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock FontSize="12" Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap">
                            Toggle a preset to include its flags in the next apply. Presets are applied
                            first; your custom flags override them if there's a conflict.
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="14,10"
                                            CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Preset.DisplayName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Preset.Description}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <ui:ToggleSwitch Grid.Column="1"
                                                             IsChecked="{Binding IsEnabled}"
                                                             VerticalAlignment="Center"
                                                             Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- ── Custom Flags ─────────────────────────────────── -->
                <ui:Card Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Code24" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Custom Flags" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock FontSize="12" Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap">
                            Add any Roblox fast flag by name. Values are written as-is into
                            ClientAppSettings.json — booleans and numbers are automatically
                            converted to their proper JSON types.
                        </TextBlock>

                        <!-- Add-flag row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding NewFlagName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Flag name  (e.g. DFIntTaskSchedulerTargetFps)"
                                        Margin="0,0,8,0"/>

                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding NewFlagValue, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Value  (e.g. 9999)"
                                        Margin="0,0,8,0">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddFlagCommand}"/>
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>

                            <ui:Button Grid.Column="2"
                                       Content="Add"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Command="{Binding AddFlagCommand}"
                                       Appearance="Primary"/>
                        </Grid>

                        <!-- Flags DataGrid -->
                        <DataGrid ItemsSource="{Binding CustomFlags}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource ControlFillColorDefaultBrush}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  MinHeight="80"
                                  CellEditEnding="FlagsGrid_CellEditEnding"
                                  x:Name="FlagsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Flag Name"
                                                    Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                    Width="*"
                                                    FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                    Width="180"
                                                    FontFamily="Consolas"/>
                                <DataGridTemplateColumn Header="" Width="46">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                       Appearance="Secondary"
                                                       Padding="4"
                                                       Command="{Binding DataContext.RemoveFlagCommand,
                                                           RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Remove flag"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                        <!-- Bottom action row -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding CustomFlags.Count, Mode=OneWay}"/>
                                <Run Text="custom flag(s) defined"/>
                            </TextBlock>

                            <ui:Button Grid.Column="1"
                                       Content="Clear All"
                                       Icon="{ui:SymbolIcon DismissCircle24}"
                                       Command="{Binding ClearAllFlagsCommand}"
                                       Appearance="Secondary"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

