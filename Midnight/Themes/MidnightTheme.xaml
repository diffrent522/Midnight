<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         MIDNIGHT PALETTE  —  deep space dark-blue / violet
    ════════════════════════════════════════════════════════════════ -->

    <!-- Raw colors -->
    <Color x:Key="Midnight.Color.Base">#08081A</Color>
    <Color x:Key="Midnight.Color.Surface">#0F0F2E</Color>
    <Color x:Key="Midnight.Color.Elevated">#161640</Color>
    <Color x:Key="Midnight.Color.Border">#2A2A6A</Color>
    <Color x:Key="Midnight.Color.Accent">#6C63FF</Color>
    <Color x:Key="Midnight.Color.AccentHover">#8B83FF</Color>
    <Color x:Key="Midnight.Color.AccentAlt">#A78BFA</Color>
    <Color x:Key="Midnight.Color.Success">#34D399</Color>
    <Color x:Key="Midnight.Color.Warning">#FBBF24</Color>
    <Color x:Key="Midnight.Color.Error">#F87171</Color>
    <Color x:Key="Midnight.Color.TextPrimary">#E8E8FF</Color>
    <Color x:Key="Midnight.Color.TextSecondary">#9090C0</Color>
    <Color x:Key="Midnight.Color.TextDisabled">#505080</Color>

    <!-- Named brushes -->
    <SolidColorBrush x:Key="BackgroundBrush"        Color="{StaticResource Midnight.Color.Base}"/>
    <SolidColorBrush x:Key="SurfaceBrush"           Color="{StaticResource Midnight.Color.Surface}"/>
    <SolidColorBrush x:Key="ElevatedBrush"          Color="{StaticResource Midnight.Color.Elevated}"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource Midnight.Color.Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"       Color="{StaticResource Midnight.Color.AccentHover}"/>
    <SolidColorBrush x:Key="AccentAltBrush"         Color="{StaticResource Midnight.Color.AccentAlt}"/>
    <SolidColorBrush x:Key="SuccessBrush"           Color="{StaticResource Midnight.Color.Success}"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="{StaticResource Midnight.Color.Warning}"/>
    <SolidColorBrush x:Key="ErrorBrush"             Color="{StaticResource Midnight.Color.Error}"/>
    <SolidColorBrush x:Key="TextBrush"              Color="{StaticResource Midnight.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="{StaticResource Midnight.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"      Color="{StaticResource Midnight.Color.TextDisabled}"/>

    <!-- WPF-UI override keys so the built-in controls pick up the Midnight palette -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"      Color="{StaticResource Midnight.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"    Color="{StaticResource Midnight.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"   Color="{StaticResource Midnight.Color.Elevated}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Midnight.Color.Border}"/>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"     Color="{StaticResource Midnight.Color.Base}"/>
    <SolidColorBrush x:Key="PaletteGreenBrush"              Color="{StaticResource Midnight.Color.Success}"/>

    <!-- Legacy alias keys still referenced by existing XAML -->
    <SolidColorBrush x:Key="Brush.Background.Dark"   Color="{StaticResource Midnight.Color.Base}"/>
    <SolidColorBrush x:Key="Brush.Surface.Dark"      Color="{StaticResource Midnight.Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Border.Dark"       Color="{StaticResource Midnight.Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Text.Primary"      Color="{StaticResource Midnight.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary"    Color="{StaticResource Midnight.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.Accent"            Color="{StaticResource Midnight.Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover"      Color="{StaticResource Midnight.Color.AccentHover}"/>

</ResourceDictionary>
